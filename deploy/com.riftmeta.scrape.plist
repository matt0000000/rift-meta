<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.riftmeta.scrape</string>

	<!-- tsx is invoked through node directly: launchd gives a job a minimal
	     PATH, so a shebang relying on `env node` is not dependable here. -->
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__PROJECT__/node_modules/tsx/dist/cli.mjs</string>
		<string>__PROJECT__/scraper/run.ts</string>
	</array>

	<key>WorkingDirectory</key>
	<string>__PROJECT__</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>DATABASE_URL</key>
		<string>__PROJECT__/data/stats.db</string>
	</dict>

	<!-- 06:15 local time daily. The scrape is idempotent, so a duplicate run
	     after a wake-from-sleep catch-up simply overwrites the same day. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>

	<!-- Catch-up on boot. launchd fires a missed calendar job after a wake, but a
	     machine that was powered off across 06:15 would otherwise leave a hole in
	     the trend history. Running at load makes the recovery explicit instead of
	     relying on launchd's semantics; the scrape upserts on (day, champion,
	     lane), so a run on a day already collected just refreshes it. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>__PROJECT__/logs/scrape.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT__/logs/scrape.log</string>
</dict>
</plist>
